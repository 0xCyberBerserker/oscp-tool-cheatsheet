{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oscp-arsenal-sync",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "../app",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/health"]
  },
  "secrets": {
    "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "ACCOUNT_PEPPER_V1"]
  },
  "vars": {
    "APP_ORIGIN": "https://arsenal.example.com",
    "API_ORIGIN": "https://arsenal.example.com"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oscp-arsenal-sync",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
