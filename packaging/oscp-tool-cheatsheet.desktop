[Desktop Entry]
Type=Application
Version=1.0
Name=OSCP Tool Cheatsheet
Name[es]=Cheatsheet de herramientas OSCP
Comment=Search installed Kali tools by name, phase or intent
Comment[es]=Busca herramientas instaladas en Kali por nombre, fase o intención
Exec=sh -c 'exec "$HOME/.local/share/oscp-tool-cheatsheet/open.sh"'
Icon=oscp-tool-cheatsheet
Terminal=false
Categories=Education;Development;Security;
Keywords=OSCP;Kali;Security;Cheatsheet;Pentest;
StartupNotify=true
